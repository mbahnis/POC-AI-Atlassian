# Copier en .env pour un usage local (le fichier .env est ignoré par Git).
# En CI, ces valeurs sont définies dans Settings > Secrets and variables > Actions.

# IA
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic          # anthropic | fake (tests, démo hors ligne)
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_MASKING=on

# Jira / Confluence
JIRA_BASE_URL=https://one-atlas-bfqf-sandbox.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PI
